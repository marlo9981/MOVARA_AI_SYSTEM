{
  "name": "task-ahlian-hook",
  "displayName": "Task.Ahlian Hook",
  "description": "Automatically extracts tasks from VSCode chat and syncs to your premium dashboard.",
  "version": "1.0.0",
  "publisher": "MovaraAI",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "task-ahlian.syncChat",
        "title": "Ahlian: Sync Current Chat as Tasks"
      }
    ],
    "configuration": {
      "title": "Task.Ahlian",
      "properties": {
        "taskAhlian.apiUrl": {
          "type": "string",
          "default": "http://localhost:3000/api/tasks",
          "description": "Your live dashboard API URL."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "20.x",
    "typescript": "^5.4.5",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0"
  }
}
